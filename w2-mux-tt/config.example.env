# Pi1 là máy chạy benchmark; Pi2 là máy phát payload.
SERVER_USER=pi
SERVER_HOST=CHANGE_ME
SERVER_PORT=
DIRECT_SHELL_COMMAND=/bin/bash --noprofile --norc

# Ma trận W2 theo tài liệu thí nghiệm.
RUN_ID=
PROTOCOLS=ssh3,ssh,mosh
SCENARIOS=W2-S1,W2-S2,W2-S4
# Số trial mỗi cấu hình lấy từ stream_mux/experiment.py
# (DEFAULT_TRIALS_PER_CONFIGURATION). Chỉ đặt khoá TRIALS_PER_COMBINATION
# ở đây khi cần ghi đè có chủ đích cho một lần chạy riêng.
SAMPLES_PER_STREAM_PER_TRIAL=100
RANDOM_SEED=20260814
WARMUP_SECONDS=5.0
STREAM_READY_TIMEOUT=20.0
TRANSFER_TIMEOUT=120.0
MOSH_CONTINUE_AFTER_TIMEOUT=1
MOSH_BARRIER_GRACE_SECONDS=5.0
# Chờ viewport vẽ nốt phần cuối sau dấu hoàn thành; thoát ngay khi đủ nội dung.
MOSH_CONTENT_SETTLE_SECONDS=0.5
INTER_TRIAL_DELAY_SECONDS=3.0
RESULT_DIR=artifacts/results
LIVE_PROGRESS=1
LIVE_PROGRESS_EVERY=10

# Payload xác định trước, được triển khai ngoài khoảng đo.
PAYLOAD_DIR=payloads
W2_REMOTE_PAYLOAD_DIR=/tmp/w2_mux_tt_payloads
MAX_CAPTURE_BYTES=2097152

# Cấu hình OpenSSH và Mosh.
PYTHON_BIN=.venv/bin/python
SSH_BIN=ssh
SSH_IDENTITY_FILE=~/.ssh/id_ed25519
SSH_STRICT_HOST_KEY_CHECKING=0
SSH_BATCH_MODE=1
MOSH_BIN=mosh
MOSH_PREDICT=always
MOSH_EXTRA_ARGS=
# 25 dòng × 4.096 byte/payload; W2-S4 dùng 100 dòng cộng marker.
W2_MOSH_COLUMNS=4096
# Mosh chỉ chạy kịch bản một workload, nên viewport chỉ cần chứa 25 dòng
# payload cùng hai dấu mốc.
W2_MOSH_ROWS=128

# SSH3 client dùng chung được build từ ../stream_mux.
SSH3_MUX_BIN=../stream_mux/bin/ssh3-mux-stdio

# Thuật toán chống tắc nghẽn của quic-go: reno (mặc định) hoặc cubic.
# Đổi giá trị này sẽ tự kích hoạt build lại binary SSH3.
SSH3_CC=reno
AUTO_BUILD_SSH3_MUX=1
SSH3_INSECURE=1
SSH3_PRIVKEY=~/.ssh/id_ed25519
SSH3_PORT=4433
SSH3_PATH=/ssh3-term
SSH3_EXTRA_ARGS=

# Bộ đếm mạng quanh mỗi trial (tc + /proc/net). Chụp ngoài khoảng đo.
COLLECT_NETWORK_COUNTERS=1
# Rỗng = tự dò theo tuyến tới máy đích (eth0 trên Pi, enp1s0 trên PC).
NETEM_IFACE=

# qlog của quic-go. CHỈ bật cho lần chạy chẩn đoán: nó ghi ~0.5 MB cho mỗi
# MB dữ liệu và sẽ làm nhiễu chính phép đo độ trễ.
SSH3_QLOG=0
SSH3_QLOG_DIR=artifacts/qlog
