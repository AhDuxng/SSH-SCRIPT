diff --git a/qlogenv/qlogenv.go b/qlogenv/qlogenv.go
new file mode 100644
index 0000000..1eff52b
--- /dev/null
+++ b/qlogenv/qlogenv.go
@@ -0,0 +1,62 @@
+// Package qlogenv bật ghi qlog theo biến môi trường QLOGDIR.
+//
+// Chỉ dùng cho lần chạy chẩn đoán: ghi qlog tốn I/O và sẽ làm nhiễu chính
+// phép đo độ trễ. Khi QLOGDIR rỗng, Tracer là nil và quic-go không tốn gì.
+package qlogenv
+
+import (
+	"bufio"
+	"context"
+	"fmt"
+	"os"
+	"path/filepath"
+
+	"github.com/quic-go/quic-go"
+	"github.com/quic-go/quic-go/logging"
+	"github.com/quic-go/quic-go/qlog"
+)
+
+// fileWriter đệm ghi để không sinh một syscall cho mỗi sự kiện qlog.
+type fileWriter struct {
+	*bufio.Writer
+	file *os.File
+}
+
+// Xả phần còn lại rồi đóng tệp.
+func (w *fileWriter) Close() error {
+	if err := w.Flush(); err != nil {
+		w.file.Close()
+		return err
+	}
+	return w.file.Close()
+}
+
+// Tracer trả về tracer ghi vào QLOGDIR, hoặc nil nếu biến này chưa đặt.
+func Tracer() func(context.Context, logging.Perspective, quic.ConnectionID) *logging.ConnectionTracer {
+	dir := os.Getenv("QLOGDIR")
+	if dir == "" {
+		return nil
+	}
+	return func(_ context.Context, p logging.Perspective, connID quic.ConnectionID) *logging.ConnectionTracer {
+		if err := os.MkdirAll(dir, 0o755); err != nil {
+			return nil
+		}
+		role := "server"
+		if p == logging.PerspectiveClient {
+			role = "client"
+		}
+		label := os.Getenv("QLOG_LABEL")
+		if label != "" {
+			label += "_"
+		}
+		name := fmt.Sprintf("%s%s_%s_%d.sqlog", label, connID.String(), role, os.Getpid())
+		file, err := os.Create(filepath.Join(dir, name))
+		if err != nil {
+			return nil
+		}
+		return qlog.NewConnectionTracer(
+			&fileWriter{Writer: bufio.NewWriterSize(file, 64*1024), file: file},
+			p, connID,
+		)
+	}
+}
