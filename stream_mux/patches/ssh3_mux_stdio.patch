+// MuxStreamSpec mô tả một session channel trong conversation hiện tại.
+type MuxStreamSpec struct {
+	Role       string
+	Command    string
+	RequestPTY bool
+}
+
+// MuxBridgeFrame là frame JSON trao đổi giữa SSH3 client và workload driver.
+type MuxBridgeFrame struct {
+	Type                 string  `json:"type"`
+	Role                 string  `json:"role,omitempty"`
+	StreamID             *uint64 `json:"stream_id,omitempty"`
+	ConversationStreamID *uint64 `json:"conversation_stream_id,omitempty"`
+	DataBase64           string  `json:"data_b64,omitempty"`
+	DataType             uint64  `json:"data_type,omitempty"`
+	ExitStatus           *uint64 `json:"exit_status,omitempty"`
+	Message              string  `json:"message,omitempty"`
+}
+
+type muxFrameWriter struct {
+	mu      sync.Mutex
+	encoder *json.Encoder
+}
+
+// write ghi tuần tự một frame để các goroutine không xen dữ liệu.
+func (w *muxFrameWriter) write(frame MuxBridgeFrame) error {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	return w.encoder.Encode(frame)
+}
+
+// muxEnvDimension đọc kích thước terminal từ biến môi trường.
+func muxEnvDimension(name string, fallback uint64) uint64 {
+	raw := os.Getenv(name)
+	value, err := strconv.ParseUint(raw, 10, 64)
+	if err != nil || value == 0 {
+		return fallback
+	}
+	return value
+}
