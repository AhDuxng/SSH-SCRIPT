+// RunMuxStdio mở các channel và bridge dữ liệu qua stdin/stdout có framing.
+// Hàm Dial nằm bên ngoài để mọi channel dùng chung connection và conversation.
+func (c *Client) RunMuxStdio(specs []MuxStreamSpec, input io.Reader, output io.Writer) error {
+	if len(specs) == 0 {
+		return fmt.Errorf("at least one mux stream is required")
+	}
+
+	writer := &muxFrameWriter{encoder: json.NewEncoder(output)}
+	channels := make(map[string]ssh3.Channel, len(specs))
+	for _, spec := range specs {
+		if spec.Role == "" || spec.Command == "" {
+			return fmt.Errorf("mux stream role and command must be non-empty")
+		}
+		if _, exists := channels[spec.Role]; exists {
+			return fmt.Errorf("duplicate mux stream role %q", spec.Role)
+		}
+		channel, err := c.OpenChannel("session", 30000, 0)
+		if err != nil {
+			return fmt.Errorf("could not open mux stream %s: %w", spec.Role, err)
+		}
+		if spec.RequestPTY {
+			termName := os.Getenv("SSH3_MUX_TERM")
+			if termName == "" {
+				termName = "xterm-256color"
+			}
+			if err := channel.SendRequest(&ssh3Messages.ChannelRequestMessage{
+				WantReply: true,
+				ChannelRequest: &ssh3Messages.PtyRequest{
+					Term:       termName,
+					CharWidth:  muxEnvDimension("SSH3_MUX_COLUMNS", 80),
+					CharHeight: muxEnvDimension("SSH3_MUX_ROWS", 24),
+				},
+			}); err != nil {
+				channel.Close()
+				return fmt.Errorf("could not request PTY for mux stream %s: %w", spec.Role, err)
+			}
+		}
+		if err := channel.SendRequest(&ssh3Messages.ChannelRequestMessage{
+			WantReply:      true,
+			ChannelRequest: &ssh3Messages.ExecRequest{Command: spec.Command},
+		}); err != nil {
+			channel.Close()
+			return fmt.Errorf("could not start mux stream %s: %w", spec.Role, err)
+		}
+		channels[spec.Role] = channel
+		streamID := uint64(channel.ChannelID())
+		conversationStreamID := channel.ConversationStreamID()
+		if err := writer.write(MuxBridgeFrame{
+			Type: "stream_open", Role: spec.Role,
+			StreamID:             &streamID,
+			ConversationStreamID: &conversationStreamID,
+		}); err != nil {
+			channel.Close()
+			return err
+		}
+
+		go func(role string, ch ssh3.Channel) {
+			defer ch.Close()
+			for {
+				message, err := ch.NextMessage()
+				if err != nil {
+					if err != io.EOF {
+						_ = writer.write(MuxBridgeFrame{
+							Type: "error", Role: role, Message: err.Error(),
+						})
+					}
+					return
+				}
+				switch message := message.(type) {
+				case *ssh3Messages.DataOrExtendedDataMessage:
+					_ = writer.write(MuxBridgeFrame{
+						Type: "data", Role: role,
+						DataBase64: base64.StdEncoding.EncodeToString([]byte(message.Data)),
+						DataType:   uint64(message.DataType),
+					})
+				case *ssh3Messages.ChannelRequestMessage:
+					switch request := message.ChannelRequest.(type) {
+					case *ssh3Messages.ExitStatusRequest:
+						status := request.ExitStatus
+						_ = writer.write(MuxBridgeFrame{
+							Type: "exit", Role: role, ExitStatus: &status,
+						})
+						return
+					case *ssh3Messages.ExitSignalRequest:
+						_ = writer.write(MuxBridgeFrame{
+							Type: "exit", Role: role,
+							Message: request.SignalNameWithoutSig + ": " + request.ErrorMessageUTF8,
+						})
+						return
+					}
+				}
+			}
+		}(spec.Role, channel)
+	}
+
+	if err := writer.write(MuxBridgeFrame{Type: "connection_ready"}); err != nil {
+		return err
+	}
+
+	decoder := json.NewDecoder(input)
+	for {
+		var frame MuxBridgeFrame
+		if err := decoder.Decode(&frame); err != nil {
+			if err == io.EOF {
+				break
+			}
+			return fmt.Errorf("invalid mux control frame: %w", err)
+		}
+		if frame.Type == "shutdown" {
+			break
+		}
+		if frame.Type != "data" {
+			_ = writer.write(MuxBridgeFrame{
+				Type: "error", Role: frame.Role,
+				Message: "unsupported control frame type " + frame.Type,
+			})
+			continue
+		}
+		channel, ok := channels[frame.Role]
+		if !ok {
+			_ = writer.write(MuxBridgeFrame{
+				Type: "error", Role: frame.Role, Message: "unknown mux role",
+			})
+			continue
+		}
+		data, err := base64.StdEncoding.DecodeString(frame.DataBase64)
+		if err != nil {
+			_ = writer.write(MuxBridgeFrame{
+				Type: "error", Role: frame.Role, Message: "invalid base64 payload",
+			})
+			continue
+		}
+		if _, err := channel.WriteData(data, ssh3Messages.SSH_EXTENDED_DATA_NONE); err != nil {
+			_ = writer.write(MuxBridgeFrame{
+				Type: "error", Role: frame.Role, Message: err.Error(),
+			})
+		}
+	}
+
+	for _, channel := range channels {
+		channel.Close()
+	}
+	return nil
+}
