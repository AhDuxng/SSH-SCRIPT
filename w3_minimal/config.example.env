# Client/driver chạy source này; server/target là thiết bị cần đo.
SERVER_USER=pi
SERVER_HOST=CHANGE_ME
SERVER_PORT=

# Script workload sẽ được scp lên target.
REMOTE_WORKLOAD=/tmp/w3_remote_workloads.sh

# Ma trận thí nghiệm.
RUN_ID=
PROTOCOLS=ssh3,ssh,mosh
TARGETS=vim,nano
PROFILE_NAMES=c0_only,c0_bg4,c0_bg4_heavy
TRIALS_PER_COMBINATION=5
RANDOM_SEED=20260724
TOKEN_INTERVAL=0.20
TOKEN_TIMEOUT=2.00
TIMEOUT_PENALTY_MS=2000
STALL_THRESHOLD_MS=1000
WARMUP_SECONDS=5.00
CHANNEL_READY_TIMEOUT=10.00
# Áp dụng giống nhau cho mọi giao thức để tránh thiên lệch thứ tự.
INTER_TRIAL_DELAY_SECONDS=3.00
SETUP_TRIALS=10
SETUP_TIMEOUT=20.00
SETUP_COOLDOWN_SECONDS=3.00
NORMAL_OUTPUT_RATE_BPS=102400
HEAVY_OUTPUT_RATE_BPS=1048576
RESULT_DIR=artifacts/results
LOG_DIR=artifacts/logs
EDITOR_START_DELAY=0.80
TERMINAL_TYPE=xterm-256color
PROBE_TEXT_FILE=payloads/probe_text.c
PROBE_SEARCH_WINDOW=0

# Hiển thị tiến độ trên client.
LIVE_PROGRESS=1
SHOW_TERMINAL_OUTPUT=0

# Binary trên client.
PYTHON_BIN=.venv/bin/python
SSH_BIN=ssh
SSH_IDENTITY_FILE=~/.ssh/id_ed25519
SSH3_BIN=bin/ssh3-mux
AUTO_BUILD_SSH3_MUX=1
MOSH_BIN=mosh
MOSH_PREDICT=always
MOSH_CAPTURE_DEBUG=1
MOSH_EXTRA_ARGS=
VIM_BIN=vim
NANO_BIN=nano

# Editor trên target.
VIM_COMMAND="{vim} -Nu NONE -n -i NONE {file}"
NANO_COMMAND="{nano} -w {file}"

# SSH3 trên target.
SSH3_INSECURE=1
SSH3_PRIVKEY=~/.ssh/id_ed25519
SSH3_PORT=4433
SSH3_PATH=/ssh3-term
SSH3_VERBOSE=1
SSH3_CAPTURE_DEBUG=1
SSH3_EXTRA_ARGS=
SSH3_KEYLOG_TEMPLATE={log_dir}/ssh3_keylog_{trial_tag}_{role}_{pid}_{ts}.log
SSH3_STREAM_SCAN_BYTES=200000
SSH3_INTERACTIVE_TEMPLATE="{ssh3_bin} {ssh3_extra_args} {ssh3_mux_args} {user}@{host}:{ssh3_port}{ssh3_path}"
