+var w3MuxStatsMu sync.Mutex
+
+// writeW3MuxStat appends benchmark counters outside the interactive PTY.
+func writeW3MuxStat(format string, args ...interface{}) {
+	path := os.Getenv("W3_SSH3_STATS_FILE")
+	if path == "" {
+		return
+	}
+	w3MuxStatsMu.Lock()
+	defer w3MuxStatsMu.Unlock()
+	f, err := os.OpenFile(path, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0600)
+	if err != nil {
+		return
+	}
+	defer f.Close()
+	fmt.Fprintf(f, format+"\n", args...)
+}
+
 func (e ExitStatus) Error() string {
 	return fmt.Sprintf("exited with status %d", e.StatusCode)
