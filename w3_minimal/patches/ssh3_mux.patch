+// StartBackgroundSession opens an exec session channel in the existing SSH3
+// conversation. Each SSH3 channel is backed by its own bidirectional QUIC
+// stream, while all channels opened through this Client share c.qconn.
+func (c *Client) StartBackgroundSession(role string, command string) (*BackgroundSessionInfo, error) {
+	channel, err := c.OpenChannel("session", 30000, 0)
+	if err != nil {
+		return nil, fmt.Errorf("could not open background channel %s: %w", role, err)
+	}
+
+	err = channel.SendRequest(
+		&ssh3Messages.ChannelRequestMessage{
+			WantReply: true,
+			ChannelRequest: &ssh3Messages.ExecRequest{
+				Command: command,
+			},
+		},
+	)
+	if err != nil {
+		channel.Close()
+		return nil, fmt.Errorf("could not start background channel %s: %w", role, err)
+	}
+
+	info := &BackgroundSessionInfo{
+		Role:                 role,
+		StreamID:             uint64(channel.ChannelID()),
+		ConversationStreamID: channel.ConversationStreamID(),
+	}
+	log.Debug().Msgf(
+		"W3_SSH3_STREAM role=%s stream_id=%d conversation_stream_id=%d",
+		info.Role,
+		info.StreamID,
+		info.ConversationStreamID,
+	)
+
+	// Drain the remote output so QUIC and channel flow control remain active.
+	// The benchmark only measures the foreground session's terminal echo.
+	go func() {
+		defer channel.Close()
+		var bytesReceived uint64
+		ready := false
+		readyBuffer := ""
+		startedAt := time.Now()
+		lastReport := startedAt
+		defer func() {
+			writeW3MuxStat(
+				"W3_SSH3_BYTES role=%s stream_id=%d bytes=%d ready=%t duration_ms=%d",
+				role, info.StreamID, bytesReceived, ready, time.Since(startedAt).Milliseconds(),
+			)
+		}()
+		for {
+			message, err := channel.NextMessage()
+			if err != nil {
+				if err != io.EOF {
+					log.Error().Msgf("background channel %s failed: %s", role, err)
+				}
+				return
+			}
+			switch message := message.(type) {
+			case *ssh3Messages.ChannelRequestMessage:
+				switch message.ChannelRequest.(type) {
+				case *ssh3Messages.ExitStatusRequest, *ssh3Messages.ExitSignalRequest:
+					return
+				}
+			case *ssh3Messages.DataOrExtendedDataMessage:
+				bytesReceived += uint64(len(message.Data))
+				if time.Since(lastReport) >= time.Second {
+					writeW3MuxStat(
+						"W3_SSH3_BYTES role=%s stream_id=%d bytes=%d ready=%t duration_ms=%d",
+						role, info.StreamID, bytesReceived, ready, time.Since(startedAt).Milliseconds(),
+					)
+					lastReport = time.Now()
+				}
+				if !ready {
+					readyBuffer = (readyBuffer + message.Data)
+					if len(readyBuffer) > 4096 {
+						readyBuffer = readyBuffer[len(readyBuffer)-4096:]
+					}
+					if strings.Contains(readyBuffer, "W3_CHANNEL_READY role="+role+" ") {
+						ready = true
+						log.Debug().Msgf("W3_SSH3_READY role=%s stream_id=%d", role, info.StreamID)
+					}
+				}
+				// Deliberately discard after reading: the bytes have traversed
+				// the SSH3 channel and its QUIC stream.
+			}
+		}
+	}()
+
+	return info, nil
+}
