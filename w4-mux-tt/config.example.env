# Máy chạy script là client/driver; SERVER_* là Raspberry Pi đích.
SERVER_USER=pi
SERVER_HOST=CHANGE_ME
SERVER_PORT=

# Ma trận W4: 3 protocol × 2 editor × 3 background scenario.
RUN_ID=
PROTOCOLS=ssh3,ssh,mosh
EDITORS=vim,nano
SCENARIOS=W4-CMD,W4-OUTPUT,W4-MIX
TRIALS_PER_COMBINATION=10
RANDOM_SEED=20260819

# Interactive workload giống W3.
PROBE_TEXT_FILE=payloads/probe_text.c
WARMUP_SECONDS=5.0
KEY_INTERVAL_SECONDS=0.20
KEY_TIMEOUT_SECONDS=2.0
STALL_THRESHOLD_SECONDS=1.0
STREAM_READY_TIMEOUT_SECONDS=15.0
EDITOR_START_SETTLE_SECONDS=1.0
BACKGROUND_START_SETTLE_SECONDS=0.20
BACKGROUND_STOP_TIMEOUT_SECONDS=15.0
BACKGROUND_COMMAND_TIMEOUT_SECONDS=30.0
BACKGROUND_OUTPUT_TIMEOUT_SECONDS=120.0
BACKGROUND_CONTINUE_ON_ERROR=1
INTER_TRIAL_DELAY_SECONDS=3.0
VERIFY_FINAL_OUTPUT=1
FINAL_OUTPUT_TIMEOUT_SECONDS=4.0
CLEANUP_REMOTE_FILES=1

# Terminal và log.
TERMINAL_TYPE=xterm-256color
TERMINAL_COLUMNS=180
TERMINAL_ROWS=48
LIVE_PROGRESS=1
LIVE_PROGRESS_EVERY=1
RESULT_DIR=artifacts/results
LOG_DIR=artifacts/logs
PYTHON_BIN=.venv/bin/python

# Payload W2-style 1 MiB, tạo và triển khai ngoài khoảng đo.
PAYLOAD_DIR=payloads
W4_REMOTE_PAYLOAD_DIR=/tmp/w4_mux_tt_payloads

# SSH.
SSH_BIN=ssh
SSH_IDENTITY_FILE=~/.ssh/id_ed25519
SSH_STRICT_HOST_KEY_CHECKING=0
SSH_BATCH_MODE=1
DIRECT_SHELL_COMMAND=/bin/bash --noprofile --norc

# SSH3 multiplex bridge.
SSH3_MUX_BIN=../stream_mux/bin/ssh3-mux-stdio
AUTO_BUILD_SSH3_MUX=1
SSH3_INSECURE=1
SSH3_PRIVKEY=~/.ssh/id_ed25519
SSH3_PORT=4433
SSH3_PATH=/ssh3-term
SSH3_EXTRA_ARGS=

# Mosh: một terminal; interactive/background nằm trong các tmux pane.
MOSH_BIN=mosh
MOSH_PREDICT=always
MOSH_EXTRA_ARGS=
MOSH_LAYOUT_QUERY_TIMEOUT_SECONDS=10.0
MOSH_BACKGROUND_MARKER_SETTLE_SECONDS=0.05

# Editor và tmux trên server.
VIM_BIN=vim
NANO_BIN=nano
TMUX_BIN=tmux
