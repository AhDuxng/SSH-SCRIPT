# Máy client/driver và máy đích từ xa.
SERVER_USER=pi
SERVER_HOST=CHANGE_ME
SERVER_PORT=
W1_REMOTE_AGENT=/tmp/w1_mux_agent.py

# Ma trận W1 đầy đủ theo tài liệu thí nghiệm.
RUN_ID=
PROTOCOLS=ssh3,ssh,mosh
SCENARIOS=W1-S1,W1-S2,W1-S4
TRIALS_PER_COMBINATION=10
SAMPLES_PER_STREAM_PER_TRIAL=100
RANDOM_SEED=20260811
WARMUP_SECONDS=5.0
STREAM_READY_TIMEOUT=20.0
COMMAND_TIMEOUT=30.0
INTER_TRIAL_DELAY_SECONDS=3.0
RESULT_DIR=artifacts/results
LIVE_PROGRESS=1
LIVE_PROGRESS_EVERY=10

# Cấu hình OpenSSH và Mosh.
SSH_BIN=ssh
SSH_IDENTITY_FILE=~/.ssh/id_ed25519
SSH_STRICT_HOST_KEY_CHECKING=0
SSH_BATCH_MODE=1
MOSH_BIN=mosh
MOSH_PREDICT=always
MOSH_EXTRA_ARGS=
W1_MOSH_COLUMNS=4096
W1_MOSH_ROWS=64

# SSH3 client dùng chung được build từ ../stream_mux.
SSH3_MUX_BIN=../stream_mux/bin/ssh3-mux-stdio
AUTO_BUILD_SSH3_MUX=1
SSH3_INSECURE=1
SSH3_PRIVKEY=~/.ssh/id_ed25519
SSH3_PORT=4433
SSH3_PATH=/ssh3-term
SSH3_EXTRA_ARGS=

PYTHON_BIN=.venv/bin/python
