# Máy chạy benchmark là client; đây là máy Linux đích.
SERVER_USER=pi
SERVER_HOST=CHANGE_ME
SERVER_PORT=
RUN_ID=

# Mỗi block chứa một trial của mọi giao thức rồi xáo trộn thứ tự.
PROTOCOLS=ssh3,ssh,mosh
TRIALS_PER_PROTOCOL=5
LOOPS_PER_TRIAL=10
WARMUP_LOOPS=1
RANDOM_SEED=20260724

SESSION_TIMEOUT=20.0
COMMAND_TIMEOUT=30.0
INTER_TRIAL_DELAY_SECONDS=3.0
RESULT_DIR=artifacts/results
FIGURE_DIR=artifacts/figures
LIVE_PROGRESS=1
TERMINAL_TYPE=xterm-256color
AUTO_PLOT=1
PLOT_METRICS=mean,median,p90,p95

SSH_BIN=ssh
SSH_IDENTITY_FILE=~/.ssh/id_ed25519
SSH_STRICT_HOST_KEY_CHECKING=0
SSH_BATCH_MODE=1

SSH3_BIN=ssh3
SSH3_INSECURE=1
SSH3_PRIVKEY=~/.ssh/id_ed25519
SSH3_PORT=4433
SSH3_PATH=/ssh3-term
SSH3_EXTRA_ARGS=

MOSH_BIN=mosh
MOSH_PREDICT=always
MOSH_EXTRA_ARGS=

PYTHON_BIN=.venv/bin/python
