SERVER_USER=pi
SERVER_HOST=CHANGE_ME
SERVER_PORT=
RUN_ID=
NETWORK_PROFILE=unspecified

PROTOCOLS=ssh3,ssh,mosh
WORKLOADS=find_usr,docker_logs,journalctl,large_file
TRIALS_PER_COMBINATION=10
SAMPLES_PER_TRIAL=100
WARMUP_SAMPLES=10
RANDOM_SEED=20260724

EVENT_INTERVAL_SECONDS=0.1
FIND_COMMAND=find /usr
DOCKER_LOGS_COMMAND=docker logs w2-log-source
JOURNALCTL_COMMAND=journalctl --no-pager
LARGE_FILE_PATH=/tmp/w2_large_file.txt
LARGE_FILE_SIZE_BYTES=16777216
PREPARE_LARGE_FILE=1
REMOTE_PREPARE_SCRIPT=/tmp/w2_prepare_large_file.sh

CLOCK_OFFSET_PROBES=5
CLOCK_OFFSET_MIN_PROBES=3
MIN_VALID_LATENCY_MS=-50
MAX_VALID_LATENCY_MS=60000

SESSION_TIMEOUT=20.0
SESSION_RETRIES=3
EVENT_TIMEOUT=20.0
PREFLIGHT_TIMEOUT=180.0
INTER_TRIAL_DELAY_SECONDS=3.0
MAX_READ_BYTES=65536

RESULT_DIR=artifacts/results
FIGURE_DIR=artifacts/figures
LIVE_PROGRESS=1
TERMINAL_TYPE=xterm-256color
AUTO_PLOT=1
PLOT_METRICS=mean,median,p90,p95

SSH_BIN=ssh
SSH_IDENTITY_FILE=~/.ssh/id_ed25519
SSH_STRICT_HOST_KEY_CHECKING=0
SSH_BATCH_MODE=1

SSH3_BIN=../w3_minimal/bin/ssh3-mux
SSH3_INSECURE=1
SSH3_PRIVKEY=~/.ssh/id_ed25519
SSH3_PORT=443
SSH3_PATH=/ssh3-term
SSH3_EXTRA_ARGS=

MOSH_BIN=mosh
MOSH_PREDICT=always
MOSH_EXTRA_ARGS=

PYTHON_BIN=.venv/bin/python
