# Máy chạy script là client/driver; SERVER_* là Raspberry Pi đích.
SERVER_USER=pi
SERVER_HOST=CHANGE_ME
SERVER_PORT=

# Ma trận W3.
RUN_ID=
PROTOCOLS=ssh3,ssh,mosh
EDITORS=vim,nano
SCENARIOS=W3-I1,W3-I2,W3-I4
# Số trial mỗi cấu hình lấy từ stream_mux/experiment.py
# (DEFAULT_TRIALS_PER_CONFIGURATION). Chỉ đặt khoá TRIALS_PER_COMBINATION
# ở đây khi cần ghi đè có chủ đích cho một lần chạy riêng.
RANDOM_SEED=20260817
PROBE_TEXT_FILE=payloads/probe_text.c

# Quy trình interactive trong tài liệu thiết kế.
WARMUP_SECONDS=5.0
KEY_INTERVAL_SECONDS=0.20
KEY_TIMEOUT_SECONDS=2.0
STALL_THRESHOLD_SECONDS=1.0
STREAM_READY_TIMEOUT_SECONDS=15.0
EDITOR_START_SETTLE_SECONDS=1.0
# Trước workload, cursor phải ở đầu vùng edit và screen-state đứng yên.
EDITOR_CURSOR_READY_TIMEOUT_SECONDS=3.0
EDITOR_CURSOR_STABLE_SECONDS=0.20
EDITOR_CURSOR_REFRESH_RETRIES=1
INTER_TRIAL_DELAY_SECONDS=3.0
TERMINAL_TYPE=xterm-256color
TERMINAL_COLUMNS=160
TERMINAL_ROWS=48
LIVE_PROGRESS=1
# 1 = in mọi ký tự của mọi stream; 10 = chỉ in mỗi 10 ký tự (lỗi luôn được in).
LIVE_PROGRESS_EVERY=1
CLEANUP_REMOTE_FILES=1

# Output.
RESULT_DIR=artifacts/results
PYTHON_BIN=.venv/bin/python

# SSH.
SSH_BIN=ssh
SSH_IDENTITY_FILE=~/.ssh/id_ed25519
SSH_STRICT_HOST_KEY_CHECKING=0
SSH_BATCH_MODE=1

# SSH3 multiplex bridge dùng chung với W1/W2.
SSH3_MUX_BIN=../stream_mux/bin/ssh3-mux-stdio

# Thuật toán chống tắc nghẽn của quic-go: reno (mặc định) hoặc cubic.
# Đổi giá trị này sẽ tự kích hoạt build lại binary SSH3.
SSH3_CC=reno
AUTO_BUILD_SSH3_MUX=1
SSH3_INSECURE=1
SSH3_PRIVKEY=~/.ssh/id_ed25519
SSH3_PORT=4433
SSH3_PATH=/ssh3-term
SSH3_EXTRA_ARGS=

# Mosh chỉ có một terminal. I2/I4 dùng editor process trong các tmux pane.
MOSH_BIN=mosh
MOSH_PREDICT=always
MOSH_EXTRA_ARGS=
# Nếu phím F5-F8 chưa làm cursor chuyển pane, gửi lại trước khi hủy trial.

# Editor trên máy đích; trial thoát không lưu sau ký tự thứ 100.
VIM_BIN=vim
NANO_BIN=nano

# Bộ đếm mạng quanh mỗi trial (tc + /proc/net). Chụp ngoài khoảng đo.
COLLECT_NETWORK_COUNTERS=1
# Rỗng = tự dò theo tuyến tới máy đích (eth0 trên Pi, enp1s0 trên PC).
NETEM_IFACE=

# qlog của quic-go. CHỈ bật cho lần chạy chẩn đoán: nó ghi ~0.5 MB cho mỗi
# MB dữ liệu và sẽ làm nhiễu chính phép đo độ trễ.
SSH3_QLOG=0
SSH3_QLOG_DIR=artifacts/qlog
