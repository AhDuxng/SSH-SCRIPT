# Pi client/driver: 100.105.79.120; PC Linux server/target: 100.106.52.7.
SERVER_USER=trungnt
SERVER_HOST=100.106.52.7
SERVER_PORT=
DIRECT_SHELL_COMMAND=/bin/bash --noprofile --norc

RUN_ID=
PROTOCOLS=ssh3,ssh,mosh
SCENARIOS=W1-S1,W1-S2,W1-S4
TRIALS_PER_COMBINATION=10
SAMPLES_PER_STREAM_PER_TRIAL=100
RANDOM_SEED=20260811
WARMUP_SECONDS=5.0
STREAM_READY_TIMEOUT=20.0
COMMAND_TIMEOUT=30.0
MOSH_CONTINUE_AFTER_TIMEOUT=1
INTER_TRIAL_DELAY_SECONDS=3.0
RESULT_DIR=artifacts/results

CONGESTION_LOG_ENABLED=1
CONGESTION_LOG_DIR=
SERVER_CONGESTION_LOG_DIR=
REMOTE_CONGESTION_DIR=/tmp/stream_mux_congestion
REMOTE_CONGESTION_SAMPLER=
CONGESTION_SAMPLE_INTERVAL_SECONDS=0.10
SSH3_SERVER_CONGESTION_DIR=/tmp/ssh3-server-congestion
LIVE_PROGRESS=1
LIVE_PROGRESS_EVERY=10

SSH_BIN=ssh
SSH_IDENTITY_FILE=~/.ssh/id_ed25519
SSH_STRICT_HOST_KEY_CHECKING=0
SSH_BATCH_MODE=1
MOSH_BIN=mosh
MOSH_PREDICT=always
MOSH_EXTRA_ARGS=
W1_MOSH_COLUMNS=4096
W1_MOSH_ROWS=128

SSH3_MUX_BIN=../stream_mux/bin/ssh3-mux-stdio
AUTO_BUILD_SSH3_MUX=1
SSH3_INSECURE=1
SSH3_PRIVKEY=~/.ssh/id_ed25519
SSH3_PORT=443
SSH3_PATH=/ssh3-term
SSH3_EXTRA_ARGS=

PYTHON_BIN=.venv/bin/python
